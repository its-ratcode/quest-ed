# Copy to .env and adjust. Never commit a real .env.
APP_ENV=development

# Required in production. Use long random strings, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
JWT_SECRET_KEY=

# Defaults to a SQLite file: backend/instance/quest_ed.db
# DATABASE_URL=sqlite:///absolute/path/to/quest_ed.db

# Where task photos are kept. Defaults to backend/instance/uploads. Back it up with the database.
# UPLOAD_FOLDER=/absolute/path/to/uploads

# Session lengths
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# Set to true when served over HTTPS (always on in production)
JWT_COOKIE_SECURE=false
