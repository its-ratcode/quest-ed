# Optional settings for `docker compose up`. Nothing here is needed: copy this file to .env
# only to change something. Never commit .env.
# (For running without Docker, the API reads backend/.env instead: see backend/.env.example.)

# The port on this computer: the app opens at http://localhost:7373
# If something else already uses it, pick another free one between 1024 and 49151.
QUESTED_PORT=7373
